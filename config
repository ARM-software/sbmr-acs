-v M3_SB_2_PLDM_PLATFORM_FUNCTIONS_SUPPORT:0
-v M3_SB_3_MCTP_TRANSPORT_PROTOCOL_SUPPORT:0
-v M3_SB_4_PLDM_OVER_MCTP_BINDING_SUPPORT:0
-v M3_SB_5_SPDM_SECURITY_PROTOCOL_SUPPORT:0
